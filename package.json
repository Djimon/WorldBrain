{
  "name": "worldbuilderx",
  "version": "0.0.23.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "lint": "eslint src core_data && npm run lint:colors",
    "lint:colors": "node scripts/check-hardcoded-colors.mjs",
    "lint:prune": "eslint src core_data --prune-suppressions",
    "check": "npm run check:toolchain && npm run check:prerequisites && npm run lint && npm run test && npm run build && npm run desktop:build",
    "check:prerequisites": "node scripts/check-prerequisites.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:spike-graph": "tauri dev --config src-tauri/tauri.spike-graph.conf.json",
    "desktop:bench-graph": "tauri dev --config src-tauri/tauri.bench-graph.conf.json",
    "desktop:look-graph": "tauri dev --config src-tauri/tauri.look-graph.conf.json",
    "desktop:spike-m10-signaling": "tauri dev --config src-tauri/tauri.m10-signaling.conf.json",
    "desktop:build": "tauri build",
    "build:desktop": "tauri build",
    "test": "node --test tests/*.test.mjs && npm run test:dom",
    "test:dom": "vitest run",
    "test:static": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-sql": "2.4.0",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "@types/dompurify": "3.0.5",
    "d3-force": "3.0.0",
    "dompurify": "3.4.11",
    "emojibase-data": "17.0.0",
    "graphology": "0.26.0",
    "i18next": "26.3.4",
    "marked": "18.0.5",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@trystero-p2p/mqtt": "0.25.3",
    "@trystero-p2p/nostr": "0.25.3",
    "@trystero-p2p/torrent": "0.25.3",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "jsdom": "29.1.1",
    "peerjs": "1.5.5",
    "react-force-graph-3d": "1.29.1",
    "three": "0.185.1",
    "trystero": "0.25.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
