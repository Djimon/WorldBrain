{
  "productName": "Worlds and Beyond",
  "version": "../package.json",
  "identifier": "WorldsAndBeyond",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worlds and Beyond",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$PICTURE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "resources": {
      "../docs/theme-tester.html": "theme-tester.html",
      "../docs/user-guide_de.md": "user-guide_de.md",
      "../docs/user-guide_en.md": "user-guide_en.md"
    }
  }
}
